# Copia questo file in ".env" e compila i valori.
# ATTENZIONE: il file ".env" reale NON va mai committato (vedi .gitignore).
# Le API key vivono SOLO qui / in variabili d'ambiente, mai nel codice.

# --- Chiavi API di terze parti (nomi standard, senza prefisso) ---
# Alpha Vantage: fonte di backup per azioni/forex. Free tier ~25 richieste/giorno.
# Ottieni una chiave gratuita su https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Twelve Data: fonte affidabile (non bloccata dal cloud) per forex/indici/oro/azioni.
# Chiave gratuita su https://twelvedata.com/ (Sign up -> API key). Free ~800 richieste/giorno.
TWELVEDATA_API_KEY=

# --- Notifiche Telegram (per gli avvisi "quando entrare") ---
# 1) Su Telegram scrivi a @BotFather -> /newbot -> ottieni il TOKEN.
# 2) Scrivi un messaggio al tuo nuovo bot, poi apri:
#    https://api.telegram.org/bot<TOKEN>/getUpdates  e copia "chat":{"id": ...}
#    (in alternativa scrivi a @userinfobot per il tuo id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Configurazione applicativa (prefisso QA_) ---
# Exchange ccxt per i dati crypto (pubblici, nessuna chiave). Kraken è raggiungibile
# anche dai server cloud/USA; Binance li blocca (usa 'kraken' per il deploy).
QA_CCXT_EXCHANGE=kraken

# Cache locale dei dati di prezzo.
QA_CACHE_DIR=.cache
QA_CACHE_TTL_MINUTES=60

# Timeout richieste di rete (secondi).
QA_REQUEST_TIMEOUT=15
